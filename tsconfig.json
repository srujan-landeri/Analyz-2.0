{
	"compilerOptions": {
	  "module": "commonjs",
	  "target": "ES2020",
	  "outDir": "out",
	  "lib": [
		"ES2020",
		"DOM",
		"DOM.Iterable"
	  ],
	  "sourceMap": true,
	  "rootDir": "src",
	  "strict": true,
	  "jsx": "react-jsx",
	  "esModuleInterop": true,
	  "skipLibCheck": true,
	  "forceConsistentCasingInFileNames": true,
	  "resolveJsonModule": true
	},
	"exclude": [
	  "node_modules",
	  ".vscode-test"
	]
  }